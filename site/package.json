{
  "name": "klickymart-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx worker/bench/bench.ts",
    "ingest": "tsx scripts/ingest.ts",
    "gen-synthetic": "tsx scripts/gen-synthetic.ts",
    "e2e": "playwright test",
    "lint:css": "node scripts/lint-css-dark.js",
    "lint:openapi": "redocly lint openapi/openapi.json 2>/dev/null || node scripts/openapi-check.js",
    "predev": "node scripts/embed-fixtures.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^4.20251014.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "~4.1.0",
    "wrangler": "^4.45.0"
  }
}
